diff --git a/include/rex/graphics/gpu_stats.h b/include/rex/graphics/gpu_stats.h
new file mode 100644
index 0000000..da707b7
--- /dev/null
+++ b/include/rex/graphics/gpu_stats.h
@@ -0,0 +1,42 @@
+// Running totals of GPU memory and per-frame work, for hosts to log (the MCLA iOS port reads them
+// every 5 seconds). Inline variables: one instance shared by the SDK and the host.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::graphics::stats {
+
+enum Counter : int {
+  // Host memory of the cached textures, as the texture cache counts it, and how many.
+  kTextureBytes,
+  kTextureCount,
+  // What the texture cache's memory allocator holds: its blocks, and what is allocated in them.
+  kTextureAllocatorBlockBytes,
+  kTextureAllocatorAllocationBytes,
+  kTextureAllocatorBlocks,
+  // Render target images (each its own allocation) and how many.
+  kRenderTargetBytes,
+  kRenderTargetCount,
+  // Work so far: texture data loads (each a compute dispatch), resolves (EDRAM to memory copies),
+  // render target ownership transfers (copies between render targets sharing EDRAM).
+  kTextureLoads,
+  kResolves,
+  kRenderTargetTransfers,
+  kCounterCount,
+};
+
+inline std::atomic<int64_t> counters[kCounterCount];
+// Per guest texture format (xenos::TextureFormat, 64 values): host bytes and texture count.
+inline std::atomic<int64_t> texture_format_bytes[64];
+inline std::atomic<int64_t> texture_format_count[64];
+
+inline void Add(Counter counter, int64_t value) {
+  counters[counter].fetch_add(value, std::memory_order_relaxed);
+}
+inline void Set(Counter counter, int64_t value) {
+  counters[counter].store(value, std::memory_order_relaxed);
+}
+inline int64_t Get(Counter counter) { return counters[counter].load(std::memory_order_relaxed); }
+
+}  // namespace rex::graphics::stats
